# Borsa MCP Environment Variables
# Copy this file to .env and update with your values

# ==========================================
# Server Configuration
# ==========================================
PORT=9000
HOST=0.0.0.0

# ==========================================
# Security - Authentication
# ==========================================
# Generate a secure key:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BORSA_API_KEY=your_secure_api_key_here_change_this_immediately

# ==========================================
# Security - CORS (Cross-Origin Resource Sharing)
# ==========================================
# Single domain:    https://yourdomain.com
# Multiple domains: https://yourdomain.com,https://app.yourdomain.com
# All domains:      * (NOT RECOMMENDED FOR PRODUCTION)
ALLOWED_ORIGINS=*

# ==========================================
# Security - Rate Limiting
# ==========================================
# Format: "number/unit" where unit can be: second, minute, hour, day
# Examples:
#   30/minute  - 30 requests per minute
#   100/hour   - 100 requests per hour
#   1000/day   - 1000 requests per day
RATE_LIMIT=30/minute

# ==========================================
# Logging
# ==========================================
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs

# ==========================================
# Features
# ==========================================
# Enable API documentation (/docs, /redoc)
# Set to 'false' in production for security
ENABLE_DOCS=true

# ==========================================
# Optional: Redis Cache (Future Enhancement)
# ==========================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# ==========================================
# Optional: Monitoring & Error Tracking
# ==========================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# Development Only (DO NOT USE IN PRODUCTION)
# ==========================================
# Disable SSL verification (SECURITY RISK!)
# PYTHONHTTPSVERIFY=0
